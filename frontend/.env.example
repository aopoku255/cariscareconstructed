# Public base URL of the Express API (exposed to the browser).
NEXT_PUBLIC_API_BASE_URL=https://api.carisca.knust.edu.gh/api/v1
# Canonical URL of this website (used for canonical links, sitemap and Open Graph).
NEXT_PUBLIC_SITE_URL=https://carisca.knust.edu.gh

# Optional: server-side API URL if the frontend server should reach the API on a private/internal address.
# Defaults to NEXT_PUBLIC_API_BASE_URL.
API_INTERNAL_BASE_URL=

# Shared secret for POST /api/revalidate (must equal REVALIDATE_SECRET in backend/.env). Server-only.
REVALIDATE_SECRET=replace_with_the_same_secret_as_the_backend

# Seconds before cached API data is refreshed even without an on-demand revalidation.
CONTENT_REVALIDATE_SECONDS=300

# Public address of the media bucket when the API stores uploads in Cloudflare R2
# (the backend's MEDIA_PUBLIC_URL). Read at build time to allow those images.
MEDIA_PUBLIC_URL=

# Set to true if the host cannot run the `sharp` image optimiser.
NEXT_IMAGE_UNOPTIMIZED=false
